# Example env for @archiyou/server. Copy to `.env` for local dev.
# Frontend-facing settings live under FRONTEND; backend settings are prefixed
# SERVER_.

# --- FRONTEND ---
# Public origin of the frontend app (editor + configurator). Base for
# password-reset links, email-verification links, and the published configurator
# URLs. Also the first entry of the CORS allowlist.
FRONTEND_URL=http://localhost:5173

# --- BACKEND: core ---
SERVER_PORT=4100
# JWT signing secret for session tokens. REQUIRED in production — the server
# refuses to boot without it when NODE_ENV=production.
#   generate with:  openssl rand -base64 48
SERVER_JWT_SECRET=change-me-to-a-long-random-string
# SQLite database file (created + migrated on first run). Relative to apps/server.
SERVER_DATABASE_FILE=./data/archiyou.db
# Extra browser origins allowed to call this API, comma-separated. FRONTEND_URL is
# always allowed. Leave empty for a same-origin deployment.
SERVER_CORS_ORIGINS=

# --- BACKEND: server-side script execution (Redis/BullMQ; see `pnpm worker`) ---
# WARNING: executed scripts are NOT sandboxed. The Runner compiles script source
# with `new AsyncFunction` and runs it in the worker's Node process, so a script
# has full Node capability (fs, child_process, network, process.env).
#
# Empty = server-side execution is DISABLED (every request 403s). That is the
# default and the safe setting. Only list authors whose code you are willing to
# run on this machine, comma-separated. Browser-side execution in the editor is
# unaffected — that is isolated in a Web Worker.
SERVER_EXECUTION_AUTHORS=
# Wall-clock cap per run. Note this cannot interrupt a tight synchronous loop
# (script code shares the event loop); container cpu/memory limits cover that.
SERVER_EXECUTION_TIMEOUT_MS=30000

# --- BACKEND: email (Mailgun, transactional — password reset, verification) ---
# Leave SERVER_MAILGUN_KEY empty in dev: links are logged to the server console
# instead of being emailed. Set it (EU region by default) to send real email.
SERVER_MAILGUN_KEY=
SERVER_MAILGUN_DOMAIN=mg.archiyou.com
SERVER_MAILGUN_API_BASE=https://api.eu.mailgun.net
SERVER_EMAIL_FROM=Archiyou <info@archiyou.com>

# --- BACKEND: development test account ---
# Seeded on boot for convenience. NEVER seeded when NODE_ENV=production unless
# you set SERVER_SEED_TEST_USER=true *and* a real SERVER_TEST_USER_PASSWORD, so
# these well-known defaults cannot reach a live instance.
# `username` is the script `author` handle used to scope ownership.
SERVER_TEST_USER_USERNAME=test
SERVER_TEST_USER_EMAIL=test@archiyou.com
SERVER_TEST_USER_PASSWORD=test1234
SERVER_TEST_USER_NAME=Test User
# SERVER_SEED_TEST_USER=false

# --- BACKEND: Redis / BullMQ (execution queue) ---
SERVER_REDIS_HOST=localhost
SERVER_REDIS_PORT=6379
SERVER_REDIS_PASSWORD=
# docker-compose.prod.yml reads REDIS_PASW to start Redis with --requirepass and
# passes it through as SERVER_REDIS_PASSWORD. Leave it unset and Redis runs OPEN.
REDIS_PASW=

# --- BACKEND: asset proxy (GET /proxy?url=, used by editor $import()) ---
# Open by default but SSRF-guarded, size-capped, timed out and rate limited.
# Set an allowlist of hostnames to narrow it; empty = any public host.
SERVER_PROXY_ALLOWLIST=
SERVER_PROXY_MAX_BYTES=5242880
SERVER_PROXY_TIMEOUT_MS=10000
SERVER_PROXY_MAX_REDIRECTS=4
SERVER_PROXY_RATE_LIMIT=60
SERVER_PROXY_RATE_WINDOW_MS=60000

# --- BACKEND: auth rate limits (per IP) ---
SERVER_AUTH_RATE_LIMIT=10
SERVER_AUTH_RATE_WINDOW=5 minutes
