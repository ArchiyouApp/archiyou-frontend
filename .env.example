# Example env for @archiyou/server. Copy to `.env` for local dev.
# Frontend-facing settings live under FRONTEND; backend settings are prefixed
# SERVER_.

# --- FRONTEND ---
# Public origin of the frontend app (editor + configurator). Base for
# password-reset links, email-verification links, and the published configurator
# URLs. Also the first entry of the CORS allowlist.
FRONTEND_URL=https://next.archiyou.com

# --- BACKEND: core ---
SERVER_PORT=4100
# JWT signing secret for session tokens. REQUIRED in production — the server
# refuses to boot without it when NODE_ENV=production.
#   generate with:  openssl rand -base64 48
SERVER_JWT_SECRET=change-me-to-a-long-random-string
# SQLite database file (created + migrated on first run). Relative to apps/server.
SERVER_DATABASE_FILE=./data/archiyou.db
# Extra browser origins allowed to call this API, comma-separated. FRONTEND_URL is
# always allowed. Leave empty for a same-origin deployment.
SERVER_CORS_ORIGINS=

# --- BACKEND: server-side script execution (Redis/BullMQ; see `pnpm worker`) ---
# WARNING: executed scripts are NOT sandboxed. The Runner compiles script source
# with `new AsyncFunction` and runs it in the worker's Node process, so a script
# has full Node capability (fs, child_process, network, process.env).
#
# Empty = server-side execution is DISABLED (every request 403s). That is the
# default and the safe setting. Only list authors whose code you are willing to
# run on this machine, comma-separated. Browser-side execution in the editor is
# unaffected — that is isolated in a Web Worker.
SERVER_EXECUTION_AUTHORS=
# Wall-clock cap per run. Note this cannot interrupt a tight synchronous loop
# (script code shares the event loop); container cpu/memory limits cover that.
SERVER_EXECUTION_TIMEOUT_MS=30000

# --- BACKEND: email (Mailgun, transactional — password reset, verification) ---
# Leave SERVER_MAILGUN_KEY empty in dev: links are logged to the server console
# instead of being emailed. Set it (EU region by default) to send real email.
SERVER_MAILGUN_KEY=
SERVER_MAILGUN_DOMAIN=mg.archiyou.com
SERVER_MAILGUN_API_BASE=https://api.eu.mailgun.net
SERVER_EMAIL_FROM=Archiyou <info@archiyou.com>

# --- BACKEND: development test account ---
# Seeded on boot for convenience. NEVER seeded when NODE_ENV=production unless
# you set SERVER_SEED_TEST_USER=true *and* a real SERVER_TEST_USER_PASSWORD, so
# these well-known defaults cannot reach a live instance.
# `username` is the script `author` handle used to scope ownership.
SERVER_TEST_USER_USERNAME=test
SERVER_TEST_USER_EMAIL=test@archiyou.com
SERVER_TEST_USER_PASSWORD=test1234
SERVER_TEST_USER_NAME=Test User
# SERVER_SEED_TEST_USER=false

# --- BACKEND: Redis / BullMQ (execution queue) ---
SERVER_REDIS_HOST=localhost
SERVER_REDIS_PORT=6379
SERVER_REDIS_PASSWORD=
# docker-compose.prod.yml reads REDIS_PASW to start Redis with --requirepass and
# passes it through as SERVER_REDIS_PASSWORD. Leave it unset and Redis runs OPEN.
REDIS_PASW=

# --- BACKEND: asset proxy (GET /proxy?url=, used by editor $import()) ---
# Open by default but SSRF-guarded, size-capped, timed out and rate limited.
# Set an allowlist of hostnames to narrow it; empty = any public host.
SERVER_PROXY_ALLOWLIST=
SERVER_PROXY_MAX_BYTES=5242880
SERVER_PROXY_TIMEOUT_MS=10000
SERVER_PROXY_MAX_REDIRECTS=4
SERVER_PROXY_RATE_LIMIT=60
SERVER_PROXY_RATE_WINDOW_MS=60000

# --- BACKEND: auth rate limits (per IP) ---
SERVER_AUTH_RATE_LIMIT=10
SERVER_AUTH_RATE_WINDOW=5 minutes

# --- BACKEND: off-box backups to S3-compatible storage (`pnpm admin:backup`) ---
# WHAT gets backed up is the `backupTargets` list in src/config.ts — the database
# and the thumbnails today. Anything not in that list is treated as regenerable and
# will be LOST on host failure, so add a line there when new durable assets appear.
#
# The database is snapshotted with SQLite's online backup API, so this is safe to
# run against a live server and needs no manual WAL checkpoint. One run writes one
# timestamped tar.gz. Scheduling comes from the host crontab — see README → Backups.
#
# Leave SERVER_BACKUP_S3_BUCKET empty and the feature is simply off (the script
# exits 2 and says so). It is never invoked by the server process itself.

# Empty endpoint = real AWS S3. For anything else, the provider's S3 endpoint:
#   Hetzner  https://<loc>.your-objectstorage.com          (region: the <loc>, e.g. hel1)
#   R2       https://<account-id>.r2.cloudflarestorage.com (region: auto)
#   B2       https://s3.<region>.backblazeb2.com           (force path style)
#   Spaces   https://<region>.digitaloceanspaces.com
#   MinIO    http://minio:9000                             (force path style)
SERVER_BACKUP_S3_ENDPOINT=
SERVER_BACKUP_S3_REGION=us-east-1
SERVER_BACKUP_S3_BUCKET=
SERVER_BACKUP_S3_ACCESS_KEY_ID=
SERVER_BACKUP_S3_SECRET_ACCESS_KEY=
# Key prefix inside the bucket, e.g. `archiyou/prod`. Archives are written as
# <prefix>/archiyou-YYYYMMDD-HHmmss.tar.gz (UTC). Pruning is scoped to the prefix,
# so instances sharing a bucket MUST use different ones or they delete each other's
# backups. Objects that are not ours are never touched whatever the prefix.
SERVER_BACKUP_S3_PREFIX=
# Path-style URLs (bucket in the path, not the hostname). Required by MinIO and
# usually Backblaze B2; leave false for AWS/R2/Spaces/Hetzner.
SERVER_BACKUP_S3_FORCE_PATH_STYLE=false
# The AWS SDK adds CRC32 checksum headers by default, which several S3-compatible
# providers reject with an opaque 400. Only set `when_supported` if yours demands them.
SERVER_BACKUP_S3_CHECKSUMS=when_required

# Adding assets without touching code: `name:path` pairs, comma-separated. Relative
# paths resolve from apps/server. In production the path must also be visible inside
# the api container (see README → Backups).
SERVER_BACKUP_EXTRA_PATHS=
# Target names to leave out of this deployment's backups, comma-separated.
SERVER_BACKUP_SKIP=
# Extra path patterns never archived, on top of the built-in ones (-wal, -shm, .bak…).
SERVER_BACKUP_EXCLUDE=
# Abort if the targets total more than this uncompressed (default 2 GiB), so adding a
# large directory fails loudly instead of silently becoming a nightly 40 GB upload.
SERVER_BACKUP_MAX_BYTES=2147483648

# Retention. After a SUCCESSFUL upload the script deletes archives under the prefix
# older than KEEP_DAYS. It only ever touches keys matching its own exact filename
# pattern, always retains the newest MIN_KEEP regardless of age, never empties the
# prefix, and never deletes more than MAX_DELETE in one run.
#
# NOTE the same credentials upload and delete, so a compromised server can erase its
# own history. If your provider supports lifecycle rules, prefer SERVER_BACKUP_PRUNE=false
# plus a bucket lifecycle rule and a write-only key.
SERVER_BACKUP_PRUNE=true
SERVER_BACKUP_KEEP_DAYS=30
SERVER_BACKUP_MIN_KEEP=3
SERVER_BACKUP_MAX_DELETE=100
# Scratch space for the database snapshot. Must be on the persistent data volume —
# the container's /tmp is not sized for it. Cleaned up after every run.
SERVER_BACKUP_TMP_DIR=./data/backup-tmp
# Whole-run wall-clock cap, so a stalled upload cannot overlap the next cron run.
SERVER_BACKUP_TIMEOUT_MS=900000
