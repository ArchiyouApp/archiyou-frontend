{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "dom"],
    "outDir": "dist",
    "rootDir": ".",
    "strict": false, // TODO: Enable strict mode and fix all resulting type errors
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "experimentalDecorators": true,
    "types": ["node"],
    "paths": {
      "meshup": ["./devlibs/meshup/src/index.ts"]
    }
  },
  "include": ["src", "tests", "devlibs"],
  "exclude": ["node_modules", "dist"]
}
