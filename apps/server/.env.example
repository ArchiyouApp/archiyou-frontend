# --- Core ---
PORT=4100
# JWT signing secret for session tokens (REQUIRED in production).
JWT_SECRET=change-me-to-a-long-random-string
# SQLite database file (created + migrated on first run).
DATABASE_FILE=./data/archiyou.db
# Editor origin (kept for future OAuth redirects).
EDITOR_URL=http://localhost:5173

# --- Test user (the single account; no users table yet) ---
# `username` is the script `author` handle used to scope ownership.
TEST_USER_USERNAME=test
TEST_USER_EMAIL=test@archiyou.com
TEST_USER_PASSWORD=test1234
TEST_USER_NAME=Test User
