# Combined gateway. It reads the SAME env as the standalone apps it composes:
#   - @archiyou/server: JWT_SECRET, DATABASE_FILE, EDITOR_URL, GOOGLE_* (see apps/server/.env.example)
#   - @archiyou/publish: LIBRARY_PATH, LIBRARY_URL, JWT_SECRET, ADMIN_PASSWORD, REDIS_* (see apps/publish/env.example)

# Port for the combined server (both APIs share it).
PORT=4000

# Set to "false" to run editor backend only (skip mounting the publish API).
MOUNT_PUBLISH=true

# --- Editor backend (required) ---
JWT_SECRET=change-me-to-a-long-random-string
DATABASE_FILE=./data/archiyou.db
EDITOR_URL=http://localhost:5173

# --- Publish (required when MOUNT_PUBLISH=true) ---
# LIBRARY_PATH=./scripts
# REDIS_HOST=localhost
# REDIS_PORT=6379
