# --- Core ---
PORT=4100
# JWT signing secret for session tokens (REQUIRED in production).
JWT_SECRET=change-me-to-a-long-random-string
# SQLite database file (created + migrated on first run).
DATABASE_FILE=./data/archiyou.db
# Editor origin — also the base for password-reset links.
EDITOR_URL=http://localhost:5173

# --- Email (Mailgun, transactional — e.g. password reset) ---
# Leave MAILGUN_KEY empty in dev: the reset link is logged to the server console
# instead of being emailed. Set it (EU region by default) to send real email.
MAILGUN_KEY=
MAILGUN_DOMAIN=mg.archiyou.com
MAILGUN_API_BASE=https://api.eu.mailgun.net
EMAIL_FROM=Archiyou <info@archiyou.com>

# --- Test user (the single account; no users table yet) ---
# `username` is the script `author` handle used to scope ownership.
TEST_USER_USERNAME=test
TEST_USER_EMAIL=test@archiyou.com
TEST_USER_PASSWORD=test1234
TEST_USER_NAME=Test User

# --- Published library + server-side execution ---
# Execution result cache directory (the DB is the source of truth for scripts).
LIBRARY_PATH=./data/cache
# Public base URL of this library (used when stamping published script URLs).
LIBRARY_URL=http://localhost:4100
# Admin password for the library admin routes (POST /auth/login → admin JWT).
ADMIN_PASSWORD=change-me-admin-password

# --- Redis / BullMQ (server-side execution queue; see `pnpm worker`) ---
REDIS_HOST=localhost
REDIS_PORT=6379
# Redis password (used by docker-compose.prod.yml as ${REDIS_PASW}).
REDIS_PASW=
# Set to 'false' to run the API without the library + /execute routes.
MOUNT_LIBRARY=true
