{
  "name": "@archiyou/publish",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Execute and publish Archiyou scripts in different contexts",
  "scripts": {
    "dev": "tsx watch src/ApiServer.ts",
    "start": "tsx src/ApiServer.ts",
    "worker": "tsx src/worker.ts",
    "worker:dev": "tsx watch src/worker.ts",
    "build": "tsc --noEmit",
    "admin:library": "tsx src/library.admin.ts",
    "docker:api:dev": "docker compose -f docker-compose.yml up --force-recreate",
    "docker:api:prod": "docker compose -f docker-compose.prod.yml up",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "test": "vitest run ./tests/",
    "test:unit": "vitest run ./tests/unit/",
    "test:integration": "vitest run ./tests/integration/",
    "test:runner": "vitest run ./tests/unit/runner.test.ts",
    "test:library": "vitest run ./tests/unit/library.test.ts",
    "test:script": "vitest run ./tests/unit/executeScript.test.ts"
  },
  "dependencies": {
    "@archiyou/core": "workspace:*",
    "@archiyou/types": "workspace:*",
    "@fastify/cors": "^9.0.1",
    "@fastify/jwt": "^8.0.1",
    "archiver": "^7.0.1",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.70.4",
    "dotenv": "^17.3.1",
    "fast-jwt": "^6.1.0",
    "fastify": "^4.29.1",
    "form-data": "^4.0.5",
    "ioredis": "^5.10.0",
    "node-fetch": "^3.3.2",
    "semver": "^7.7.4"
  },
  "devDependencies": {
    "@fastify/type-provider-typebox": "^5.2.0",
    "@google/genai": "^1.44.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/ioredis": "^5.0.0",
    "@types/json-schema": "^7.0.15",
    "@types/node": "^25.5.0",
    "@types/semver": "^7.7.0",
    "@typescript-eslint/eslint-plugin": "^8.57.0",
    "@typescript-eslint/parser": "^8.57.0",
    "ajv": "^8.18.0",
    "eslint": "^9.39.4",
    "google-auth-library": "^10.6.1",
    "google-spreadsheet": "^5.2.0",
    "googleapis": "^166.0.0",
    "testcontainers": "^11.12.0",
    "tsx": "^4.21.0",
    "typescript": "^5.7.3",
    "vitest": "^4.0.18"
  }
}
