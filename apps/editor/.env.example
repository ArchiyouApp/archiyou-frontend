# Editor app env. Copy to `.env` for local dev.
#
# IMPORTANT: this is read at BUILD time, not at runtime. Vite inlines the value
# into the bundle (see src/services/api.ts), so changing it means rebuilding —
# you cannot repoint an existing build at a different API by editing a file on
# the server.
#
# Base URL of the backend API (apps/server). Leave empty to call the same origin
# the editor is served from.
SERVER_API_BASE_URL=http://localhost:4100

# --- Production ---
# In the recommended deployment (apps/server/Caddyfile) one host serves both the
# editor and the API, with Caddy stripping an /api prefix. Build with:
#
#   SERVER_API_BASE_URL=/api pnpm --filter @archiyou/editor build
#
# That keeps every request same-origin, so CORS never applies. Use an absolute
# URL (e.g. https://api.archiyou.com) only if you deliberately split the origins,
# and then add the editor's origin to SERVER_CORS_ORIGINS on the server.
