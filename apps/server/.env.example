# Example env for @archiyou/server. Copy to `.env` for local dev.
# Frontend-facing settings live under FRONTEND; backend settings are prefixed
# SERVER_.

# --- FRONTEND ---
# Public origin of the frontend app (editor + configurator). Base for
# password-reset links and the published configurator URLs.
FRONTEND_URL=http://localhost:5173

# --- BACKEND: core ---
SERVER_PORT=4100
# JWT signing secret for session tokens (REQUIRED in production).
SERVER_JWT_SECRET=change-me-to-a-long-random-string
# SQLite database file (created + migrated on first run).
SERVER_DATABASE_FILE=./data/archiyou.db
# Admin password for the library admin routes (POST /auth/login → admin JWT).
SERVER_ADMIN_PASSWORD=change-me-admin-password

# --- BACKEND: email (Mailgun, transactional — e.g. password reset) ---
# Leave SERVER_MAILGUN_KEY empty in dev: the reset link is logged to the server
# console instead of being emailed. Set it (EU region by default) to send email.
SERVER_MAILGUN_KEY=
SERVER_MAILGUN_DOMAIN=mg.archiyou.com
SERVER_MAILGUN_API_BASE=https://api.eu.mailgun.net
SERVER_EMAIL_FROM=Archiyou <info@archiyou.com>

# --- BACKEND: test user (the single account; no users table yet) ---
# `username` is the script `author` handle used to scope ownership.
SERVER_TEST_USER_USERNAME=test
SERVER_TEST_USER_EMAIL=test@archiyou.com
SERVER_TEST_USER_PASSWORD=test1234
SERVER_TEST_USER_NAME=Test User

# --- BACKEND: Redis / BullMQ (server-side execution queue; see `pnpm worker`) ---
SERVER_REDIS_HOST=localhost
SERVER_REDIS_PORT=6379
SERVER_REDIS_PASSWORD=
